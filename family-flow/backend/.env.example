# Family Flow — variables d'environnement (exemple, sans secrets)

ANTHROPIC_API_KEY=
PORT=3002
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=

# EcoleDirecte
ED_USERNAME=
ED_PASSWORD=

# ===========================================================================
# LLM multi-providers (no lock-in) — voir src/config/models.js
# ===========================================================================
# Provider par défaut (tier "smart") : openai | deepseek | anthropic
LLM_DEFAULT_PROVIDER=openai

# --- OpenAI (GPT) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.5-mini
# OPENAI_REASONING_MODEL=
# OPENAI_VISION_MODEL=

# --- DeepSeek (compatible OpenAI) ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_REASONING_MODEL=deepseek-reasoner

# --- Routing par tier (surcharges "provider:model") ---
# LLM_TIER_FAST=deepseek:deepseek-chat
# LLM_TIER_SMART=openai:gpt-5.5
# LLM_FALLBACK_ORDER=openai,anthropic,deepseek

# ===========================================================================
# Auth — code d'accès familial
# ===========================================================================
# Laisser VIDE = aucune protection (usage local). Définir un code = toutes les
# routes /api exigent ce code (indispensable avant tout hébergement en ligne).
FAMILY_ACCESS_CODE=
# Secret aléatoire pour signer le token (généré, ne pas partager).
AUTH_SECRET=
